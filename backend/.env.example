# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
MONGO_URL="mongodb://localhost:27017"
DB_NAME="admin_dashboard_db"

# CORS Configuration
CORS_ORIGINS="*"

# JWT Configuration
JWT_SECRET="your-secure-jwt-secret-key-at-least-32-characters-long"

# Master Key for Super Admin Access
# ⚠️ IMPORTANT: Change this to a unique, strong key before deployment!
# Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_KEY="your-secure-master-key-here"

# Optional: Rate Limiting
# RATE_LIMIT_LOGIN="10/minute"
# RATE_LIMIT_CLAIM="30/minute"
